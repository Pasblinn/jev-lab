#!/bin/sh
# Claude Code hook, loaded only by the fallback launch. $1 = hook event name.
REASON=$(cat "$HOME/.jev/DOWN" 2>/dev/null || echo "unknown")
MSG="JEV FORA DO AR - sessao rodando em Claude normal, SEM roteamento. Motivo: $REASON. Diagnostico: jev-health; cat ~/.jev/DOWN"
[ "$1" = "SessionStart" ] && osascript -e "display notification \"$REASON\" with title \"JEV FORA DO AR\" sound name \"Basso\"" >/dev/null 2>&1
python3 - "$1" "$MSG" <<'PY'
import json,sys
ev,msg=sys.argv[1],sys.argv[2]
print(json.dumps({"systemMessage":"🚨 "+msg,"hookSpecificOutput":{"hookEventName":ev,"additionalContext":"SEVERE: "+msg+" Tell the user this in the first line of your next reply."}}))
PY

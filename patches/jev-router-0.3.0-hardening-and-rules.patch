+const HOOK_PATH = "/Users/pablin/.claude/hooks/block-dangerous-git.py";
+
+function runPreToolHook(command) {
+  const payload = JSON.stringify({
+    tool_name: "Bash",
+    tool_input: { command },
+  });
+  const res = spawnSync("python3", [HOOK_PATH], {
+    input: payload,
+    encoding: "utf-8",
+  });
+  const out = (res.stdout || "").trim();
+  if (!out) return { decision: "allow" };
+  try {
+    return JSON.parse(out);
+  } catch (err) {
+    return { decision: "error", raw: out };
+  }
+}

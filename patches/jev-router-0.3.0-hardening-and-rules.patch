+test("Safety Matrix 1: Production & Infrastructure tasks NEVER route to weak tiers", () => {
+  const dangerousPrompts = [
+    "Deploy release v2.4 to production cluster",
+    "SSH into VPS 192.168.1.10 and restart services",
+    "Run db migration to drop table legacy_users in prod",
+    "pg_dump production database to s3 bucket",
+    "Update the secret token in .env and reload api_key",
+    "Publish new npm release to registry",
+  ];
+
+  for (const prompt of dangerousPrompts) {
+    assert.equal(isSensitiveTask(prompt), true, `Must detect sensitive prompt: ${prompt}`);
+
+    // Even if Jev proposes haiku with 100% confidence and context is only 2,000 tokens:
+    const decision = decide({
+      prompt,
+      jev: { choice: "haiku", confidence: 1.0 },
+      current: "opus",
+      available: ["haiku", "sonnet", "opus"],
+      contextTokens: 2000,
+    });
+
+    assert.equal(decision.tier, "opus", `Sensitive task '${prompt}' must stay on Opus`);
+    assert.match(decision.reason, /sensitive-task-locked-to-frontier/);
+    assert.equal(decision.changed, false);
+  }
+});
